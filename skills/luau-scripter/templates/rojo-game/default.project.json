          "$path": "src/client"
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "ClockTime": 14.5,
        "Brightness": 2.5,
        "EnvironmentDiffuseScale": 1,
        "EnvironmentSpecularScale": 1
      },
      "$ignoreUnknownInstances": true
    },
    "Workspace": {
      "$properties": {
        "Gravity": 196.2
      },
      "$ignoreUnknownInstances": true,
      "Start": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Size": [12, 1, 12],
          "Position": [0, 0.5, 0],
          "Color": [1, 0.73, 0.87],
          "Material": "SmoothPlastic",
          "Neutral": true,
          "Duration": 0
        }
      }
    }
  }
}
